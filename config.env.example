# Environment-specific settings for al-molecular.
#
# Copy this file to config.env and edit it for your own environment:
#   cp config.env.example config.env
#
# config.env itself is gitignored (it's environment-specific, not
# portable) -- this .example file is the committed template. Every
# slurm/*.sh script sources config.env (if present) right after resolving
# its own repo root; run_experiment.py reads it too when run directly. Any
# variable left unset here (or if config.env doesn't exist at all) falls
# back to this repo's original defaults -- nothing breaks if you never
# create config.env.
#
# NOT covered here: SLURM partition (-p) and log-file (-o/-e) paths.
# #SBATCH directives are parsed by `sbatch` before the script body (and
# this file) is ever read, so they can't come from a sourced config file --
# edit those lines directly per cluster, or override at submit time with
# `sbatch -p <partition> -o <path> -e <path> script.sh`.

# --- conda environment ---
CONDA_SH=/N/slate/mengjing/miniconda3/etc/profile.d/conda.sh
CONDA_ENV=py310

# --- SLURM account (uniform across all scripts, unlike partition) ---
SLURM_ACCOUNT=r00939

# --- data that lives outside the repo (see run_experiment.py's DATASETS) ---
AMPC_ROOT=/N/project/SingleCell_Image/mengjing/ampc_99.5M
ENHITS_LARGE_EMBED_DIR=/N/project/SingleCell_Image/mengjing/enhits_large/embed

# --- output location for run_experiment.py's default --run-dir ---
# Leave blank to use <repo>/runs (today's default behavior).
RUNS_DIR=
